---
import type { Locale } from "../../i18n/locales";
import { localePath } from "../../i18n/routing";
import SearchTrigger from "../search/SearchTrigger.astro";
import { MobileMenu } from "./MobileMenu";

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const homePath = localePath(locale);
const aboutPath = localePath(locale, "/about");
const isAbout = pathname === aboutPath;
---

<header
  class="sticky top-0 z-40 border-b border-[var(--rule)] bg-[color-mix(in_srgb,var(--bg)_94%,transparent)] backdrop-blur-sm"
>
  <div
    class="mx-auto flex h-[57px] w-full max-w-[680px] items-center px-4 sm:px-5"
  >
    <a
      href={homePath}
      aria-label="seojuny.dev"
      class="shrink-0 text-[15px] font-semibold tracking-[-0.012em]"
    >
      seojuny<span class="font-normal text-[var(--muted)]">.dev</span>
    </a>

    <nav
      aria-label="Primary"
      class="ml-8 hidden items-center gap-6 text-[14px] font-medium md:flex"
    >
      <a
        href={homePath}
        aria-current={!isAbout ? "page" : undefined}
        class:list={[
          "relative transition-colors duration-200",
          !isAbout
            ? "text-[var(--fg)]"
            : "text-[var(--muted)] hover:text-[var(--fg)]",
        ]}
      >
        Posts
        {
          !isAbout && (
            <span
              aria-hidden="true"
              class="absolute right-0 -bottom-1.5 left-0 h-px bg-[var(--fg)]"
            />
          )
        }
      </a>
      <a
        href={aboutPath}
        aria-current={isAbout ? "page" : undefined}
        class:list={[
          "relative transition-colors duration-200",
          isAbout
            ? "text-[var(--fg)]"
            : "text-[var(--muted)] hover:text-[var(--fg)]",
        ]}
      >
        About
        {
          isAbout && (
            <span
              aria-hidden="true"
              class="absolute right-0 -bottom-1.5 left-0 h-px bg-[var(--fg)]"
            />
          )
        }
      </a>
    </nav>

    <div
      class="ml-auto hidden items-center border-l border-[var(--rule)] pl-4 md:flex"
    >
      <SearchTrigger />
    </div>

    <div class="ml-auto flex items-center gap-3 md:hidden">
      <SearchTrigger />
      <MobileMenu client:media="(max-width: 767px)" {locale} {pathname} />
    </div>
  </div>

  <div
    id="reading-progress"
    aria-hidden="true"
    class="pointer-events-none absolute right-0 -bottom-px left-0 h-[2px]"
  >
  </div>
</header>
